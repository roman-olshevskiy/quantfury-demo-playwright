# Copy to .env and adjust. Every variable is optional; defaults are shown.
# Only safe example values belong here: no credentials, tokens or session data.

# Web application under test (HTTPS only).
BASE_URL=https://trading.quantfury.com/

# Demo bootstrap host and demo REST API host, as observed in docs/product-discovery.md.
DEMO_BOOTSTRAP_URL=https://b1.trdngbcknd.com/
API_BASE_URL=https://n1.trdngbcknd.com/

# Parallel workers (1-4). Keep live runs at 1-2; 4 is intended for the mocked suite.
WORKERS=1

# Set automatically by GitHub Actions. Accepts true/false/1/0.
CI=false

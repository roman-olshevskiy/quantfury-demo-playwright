{
  "name": "quantfury-demo-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Independent portfolio test-automation framework (Playwright + TypeScript) for the public Quantfury demo mode.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:deps": "npm audit --audit-level=high && npm audit signatures",
    "test": "playwright test --project=api-live --project=ui-chromium --project=ui-mocked --grep \"@smoke|@mocked\"",
    "test:smoke": "playwright test --project=api-live --project=ui-chromium --grep @smoke",
    "test:api": "playwright test --project=api-live",
    "test:ui": "playwright test --project=ui-chromium --grep-invert @integration",
    "test:integration": "playwright test --project=ui-chromium --grep @integration",
    "test:mocked": "playwright test --project=ui-mocked",
    "test:regression": "playwright test --project=api-live --project=ui-chromium --grep @regression",
    "test:cross-browser": "playwright test --project=ui-chromium --project=ui-firefox-smoke --project=ui-webkit-smoke --grep @smoke",
    "test:full": "playwright test --project=api-live --project=ui-chromium --project=ui-mocked",
    "test:select": "playwright test",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:debug": "playwright test --project=ui-chromium --debug",
    "test:ui-mode": "playwright test --ui",
    "test:trace": "playwright test --project=ui-chromium --trace=on --retries=0",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dotenv": "18.0.5",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "zod": "4.6.5"
  }
}
